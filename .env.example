# Export variables in your shell before starting. This file is documentation.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# MiniCPM runs locally only when enabled. First load downloads about 5 GB.
EMBODIED_MINICPM=0
EMBODIED_DEVICE=auto
# Apple Silicon: set EMBODIED_DEVICE=mps to require the Apple GPU.
# After a successful warmup, HF_HUB_OFFLINE=1 prevents download requests.
# Optional existing typed-decision endpoint (for MiniCPM-Jev or a compatible adapter).
EMBODIED_LOCAL_URL=http://127.0.0.1:8078/v1/systemone
EMBODIED_LOCAL_KEY=
EMBODIED_LOCAL_MODEL=minicpm-jev
# OpenAI-compatible chat completions. Keep Base URL through /v1, without /chat/completions.
EMBODIED_API_BASE=
EMBODIED_API_KEY=
EMBODIED_API_MODEL=
# Claude native Messages API (independent of OpenAI-compatible settings).
EMBODIED_CLAUDE_BASE=https://api.anthropic.com/v1
EMBODIED_CLAUDE_MODEL=claude-fable-5-1
ANTHROPIC_API_KEY=
